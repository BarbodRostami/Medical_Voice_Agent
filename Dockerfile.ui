FROM python:3.10-slim

WORKDIR /app

COPY requirements-ui.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "backend/app_ui.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0"]
