# ─── Object Storage (Parmin Cloud S3-compatible) ─────────────────────────────
# S3 API base endpoint (without bucket subdomain)
LIARA_ENDPOINT=https://sas.amin.parminstorage.ir
# Bucket name
LIARA_BUCKET=voiceai
# Your access credentials (get from Parmin Cloud panel)
LIARA_ACCESS_KEY=your_access_key_here
LIARA_SECRET_KEY=your_secret_key_here

# Do NOT send Parmin/S3 traffic through HTTP proxy (causes timeouts from laptop)
NO_PROXY=sas.amin.parminstorage.ir,parminstorage.ir,localhost,127.0.0.1
no_proxy=sas.amin.parminstorage.ir,parminstorage.ir,localhost,127.0.0.1

# Public API URL for audio_url links (company server IP)
PUBLIC_API_URL=http://192.168.1.15:8000

# Shared secret for API access (send as header: X-API-Key: <value>)
# If empty/unset, auth is disabled (local dev only). Set a strong value on the company server.
# Give this same key to the external-server team for HTTP API calls (see COLLABORATOR_API.md).
# For TTS they also need S3 credentials to poll/download MP3 (same LIARA_* / Parmin keys).
API_KEY=change-me-to-a-long-random-secret

# When API_KEY is set, OpenAPI UI (/docs, /redoc) is hidden by default.
# EXPOSE_API_DOCS=1
# DISABLE_API_DOCS=1

# Browser audio_url links are HMAC-signed when API_KEY (or AUDIO_SIGNING_SECRET) is set.
# HakimAI S3 poll does not use /voice/audio — leave defaults unless debugging unsigned links.
# AUDIO_SIGNING_SECRET=optional-separate-secret
# AUDIO_PROXY_REQUIRE_SIGNATURE=0

# ─── Optional ─────────────────────────────────────────────────────────────────
# Django admin save endpoint (leave default if not using Django panel)
# DJANGO_URL=http://django-admin:8000/save_chat/

# TTS provider for /api/ask and voice jobs.
# Default is always local edge-tts. Paid/cloud is optional; on any failure → edge.
#   edge   = Microsoft edge-tts (free, no GPU) — DEFAULT / automatic fallback
#   openai = OpenAI-compatible /audio/speech (OpenAI, GapGPT, …); needs API key
# TTS_PROVIDER=edge
#
# Shared OpenAI-compatible credentials (RAG chat + TTS + optional STT + speech LLM):
# OPENAI_API_KEY=your-gapgpt-or-openai-key
#   (aliases also accepted: GAPGPT_API_KEY, OPENAI_TTS_API_KEY)
# OPENAI_BASE_URL=https://api.gapgpt.app/v1
#   (alias: GAPGPT_BASE_URL)
#
# Answer LLM for /chat RAG (default ollama BioMistral; openai = GapGPT/OpenAI chat):
# LLM_PROVIDER=ollama
# LLM_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4o-mini
# On openai failure → falls back to local Ollama.
#
# Example GapGPT TTS (only when ready — leave commented to stay on edge):
# TTS_PROVIDER=openai
# OPENAI_API_KEY=your-gapgpt-or-openai-key
# OPENAI_BASE_URL=https://api.gapgpt.app/v1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
#
# Or official OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=nova
#
# Digits in speech-prep (before ANY TTS engine):
#   ascii   = keep 0-9 (default; required for GapGPT — Persian digits often skipped)
#   words   = 92 → «نود و دو» (clearest for medical vitals)
#   persian = ۰-۹ (legacy; some edge voices only)
# TTS_DIGIT_MODE=ascii
#
# Optional LLM polish after dictionary + phrasing (default off). Falls back to dict-only.
# For presentation-quality spoken Persian, set to 1 when GapGPT/OpenAI chat is available:
# SPEECH_NORMALIZE_LLM=1
# OPENAI_SPEECH_LLM_MODEL=gpt-4o-mini
#
# STT provider for /api/cases voice (default local Whisper). Cloud falls back to local.
#   local  = faster-whisper on this machine — DEFAULT
#   openai = OpenAI-compatible /audio/transcriptions (GapGPT / OpenAI)
# STT_PROVIDER=local
# Example GapGPT STT (same OPENAI_API_KEY / OPENAI_BASE_URL as TTS):
# STT_PROVIDER=openai
# OPENAI_STT_MODEL=whisper-1

# Whisper STT (collaborator voice → text). medium = better Persian, slower on CPU.
# WHISPER_MODEL_SIZE=medium
# WHISPER_BEAM_SIZE=8
# Prefer explicit CPU on laptops where CUDA float16 fails:
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# If unset, code auto-tries CUDA float16/int8/float32 then falls back to CPU int8.
# On a working NVIDIA GPU: WHISPER_DEVICE=cuda and WHISPER_COMPUTE_TYPE=float16 (or int8)

# Local smoke / presentation demos (no server required):
#   python scripts/smoke_voice_providers.py
#   python scripts/smoke_voice_providers.py --tts --provider openai
#   → assets/audio/scratch/
#   python scripts/demo_voice_ab.py
#   python scripts/demo_voice_ab.py --with-llm
#   → assets/audio/demo/
# Checklist: docs/VOICE_DEMO_CHECKLIST.md
# Script index: scripts/README.md
