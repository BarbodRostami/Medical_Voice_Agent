# ─── Object Storage (Parmin Cloud S3-compatible) ─────────────────────────────
# S3 API base endpoint (without bucket subdomain)
LIARA_ENDPOINT=https://sas.amin.parminstorage.ir
# Bucket name
LIARA_BUCKET=voiceai
# Your access credentials (get from Parmin Cloud panel)
LIARA_ACCESS_KEY=your_access_key_here
LIARA_SECRET_KEY=your_secret_key_here

# Do NOT send Parmin/S3 traffic through HTTP proxy (causes timeouts from laptop)
NO_PROXY=sas.amin.parminstorage.ir,parminstorage.ir,localhost,127.0.0.1
no_proxy=sas.amin.parminstorage.ir,parminstorage.ir,localhost,127.0.0.1

# Public API URL for audio_url links (company server IP)
PUBLIC_API_URL=http://192.168.1.15:8000

# Shared secret for API access (send as header: X-API-Key: <value>)
# If empty/unset, auth is disabled (local dev only). Set a strong value on the company server.
# Give this same key to the external-server team for HTTP API calls (see COLLABORATOR_API.md).
# For TTS they also need S3 credentials to poll/download MP3 (same LIARA_* / Parmin keys).
API_KEY=change-me-to-a-long-random-secret

# ─── Optional ─────────────────────────────────────────────────────────────────
# Django admin save endpoint (leave default if not using Django panel)
# DJANGO_URL=http://django-admin:8000/save_chat/
# Whisper STT (collaborator voice → text). medium = better Persian, slower on CPU.
# WHISPER_MODEL_SIZE=medium
# WHISPER_BEAM_SIZE=8
# Prefer explicit CPU on laptops where CUDA float16 fails:
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# If unset, code auto-tries CUDA float16/int8/float32 then falls back to CPU int8.
# On a working NVIDIA GPU: WHISPER_DEVICE=cuda and WHISPER_COMPUTE_TYPE=float16 (or int8)
